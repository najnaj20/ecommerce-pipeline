# Copy to .env and adjust for your environment.
# Defaults below match the local docker-compose / setup scripts.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=ecommerce.events
KAFKA_GROUP=bronze-loader

PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce
PGUSER=ecom
PGPASSWORD=ecom_dev_only

# Producer behaviour (demo knobs)
EVENT_COUNT=500
CORRUPTION_RATE=0.02
DUPLICATE_RATE=0.03
STREAM_SPAN_HOURS=72
